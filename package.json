{
  "name": "tche-food",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.functions.json",
    "test": "vitest run",
    "build:ifood": "vite build --ssr server/delivery/ifood/main.ts --outDir dist-ifood --emptyOutDir",
    "start:ifood": "node dist-ifood/main.js"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "fast-xml-parser": "^5.11.0",
    "lucide-react": "0.453.0",
    "qrcode-generator": "^1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.183.2",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
